# zakura for the benchmark: the archive state, live mainnet peers. Peer cache and identity stay
# in the benchmark root, away from a default node. The embedded node of ztreamerd refuses
# [tracing] and [metrics] sections. The JSON-RPC listener lets the harness read the node tip.
[network]
network = "Mainnet"
listen_addr = "0.0.0.0:18233"
cache_dir = "@ROOT@/zakura-network"
identity_dir = "@ROOT@/zakura-identity"

[network.zakura]
listen_addr = "0.0.0.0:18234"

[state]
cache_dir = "@ZAKURA_CACHE@"
delete_old_database = false

[rpc]
listen_addr = "127.0.0.1:8232"
enable_cookie_auth = false
